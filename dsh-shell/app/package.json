{
  "name": "dsh-shell-app",
  "productName": "DeepSeek Harness",
  "version": "0.14.2",
  "description": "DeepSeek Harness 独立桌面壳（Electron，Windows/macOS/Linux）：窗口 + 托盘 + 服务控制。与 DSH 更新完全解耦（纯 HTTP 契约）。",
  "author": "Marty Yao <martyyao@users.noreply.github.com>",
  "homepage": "https://github.com/MartyYao/deepseek-harness-deck",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.dsh.shell",
    "productName": "DeepSeek Harness",
    "publish": [
      { "provider": "generic", "url": "https://github.com/MartyYao/deepseek-harness-deck/releases/latest/download" }
    ],
    "files": [
      "main.js",
      "version.js",
      "preload.cjs",
      "assets/**"
    ],
    "extraResources": [
      { "from": "resources/node-bin", "to": "node-bin" }
    ],
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "DeepSeek.Harness.Setup.${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "appImage": {
      "artifactName": "DeepSeek.Harness-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
